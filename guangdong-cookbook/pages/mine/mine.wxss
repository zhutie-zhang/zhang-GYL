.page { padding-bottom: 80rpx; }
.wrap { flex-wrap: wrap; }

.center { justify-content: flex-start; }
.stepper {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #eef5ec; color: #5b8c5a; text-align: center; line-height: 56rpx; font-size: 32rpx;
}
.fam-num { margin: 0 20rpx; font-size: 34rpx; font-weight: 600; color: #5b8c5a; }

.vline { padding: 18rpx 0; border-bottom: 1rpx solid #f3efe7; }
.sw {
  width: 84rpx; height: 46rpx; border-radius: 24rpx; background: #e0ddd4; position: relative; transition: .2s;
}
.sw.on { background: #5b8c5a; }
.knob { position: absolute; top: 4rpx; left: 4rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; transition: .2s; }
.sw.on .knob { left: 42rpx; }

.rec { border-left: 8rpx solid #5b8c5a; }
.rec-date { font-size: 28rpx; font-weight: 600; }
.right { text-align: center; }
.rec-score { display: block; font-size: 40rpx; font-weight: 700; color: #5b8c5a; }
.rec-grade { font-size: 22rpx; color: #b0aca2; }
.mini { padding: 8rpx 26rpx; font-size: 24rpx; margin: 0; }