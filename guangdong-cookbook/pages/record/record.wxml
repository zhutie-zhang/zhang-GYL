<view class="page">
  <view class="card top">
    <view class="row">
      <text class="card-title s1">记录日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="date-pick">{{date}} ▾</view>
      </picker>
    </view>
    <view class="row actions">
      <view class="btn btn-ghost mini" bindtap="fillMenu">代入今日推荐</view>
      <view class="btn btn-ghost mini" bindtap="clearAll">清空</view>
    </view>
  </view>

  <view class="sec-title">勾选今天实际吃过的菜（{{selCount}} 道）</view>
  <view class="groups">
    <view class="card" wx:for="{{groups}}" wx:for-item="g" wx:key="kind">
      <view class="gro-title">{{g.kind}}</view>
      <view class="opt row" wx:for="{{g.items}}" wx:for-item="r" wx:key="id"
            data-id="{{r.id}}" bindtap="toggle">
        <text class="s1">{{r.name}}</text>
        <view class="ck {{selected[r.id] ? 'on' : ''}}">{{selected[r.id] ? '✔' : ''}}</view>
      </view>
    </view>
  </view>

  <view class="summary fixed" wx:if="{{summary}}">
    <view class="row">
      <view class="s1">
        <text class="s-score">{{summary.kcal}} 千卡</text>
        <text class="s-count">· {{summary.varieties}} 种食材</text>
      </view>
      <view class="s-right">
        <text class="s-score">{{summary.score}}分</text>
        <text class="s-grade">{{summary.grade}}</text>
      </view>
    </view>
    <view class="mini-bars">
      <view class="mbar" wx:for="{{bars}}" wx:key="k">
        <text class="mb-label">{{item.k}}</text>
        <view class="nut-bar"><view class="nut-lv-{{item.lv}}" style="width:{{item.pct}}%;"></view></view>
        <text class="mb-val">{{item.v}}{{item.u}}</text>
      </view>
    </view>
    <view class="tips"><view wx:for="{{summary.tips}}" wx:key="*this" class="tip-line">· {{item}}</view></view>
    <view class="btn btn-primary" bindtap="save">保存记录</view>
  </view>

  <view class="blank" wx:if="{{summary}}"></view>
  <view class="btn btn-primary bottom-save" bindtap="save">保存记录</view>
</view>